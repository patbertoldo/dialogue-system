  dialogueBlocks:
  - Alignment: 0
    Emotion: 0
    DialogueCharacter: {fileID: 11400000, guid: 732633cda027468488b8f777e678e979, type: 2}
    Description: 'Emotions are tied together by two properties:

      <b>a)</b>
      The character portrait and

      <b>b)</b> The sound at the start of the dialogue.'
    TextSpeed: 20
    CommandDatas:
    - Name: Default
      Value: 131
    DescriptionSanitized: 'Emotions are tied together by two properties:

      <b>a)</b>
      The character portrait and

      <b>b)</b> The sound at the start of the dialogue.'
  - Alignment: 1
    Emotion: 4
    DialogueCharacter: {fileID: 11400000, guid: af8ec95ad12565a43a2d2093a0df8efc, type: 2}
    Description: Are you saying that I can change my emotion mid dialogue?
    TextSpeed: 20
    CommandDatas:
    - Name: Default
      Value: 56
    DescriptionSanitized: Are you saying that I can change my emotion mid dialogue?
  - Alignment: 0
    Emotion: 1
    DialogueCharacter: {fileID: 11400000, guid: 732633cda027468488b8f777e678e979, type: 2}
    Description: Well, not only that! When an emotion changes, both properties are
      played.
    TextSpeed: 20
    CommandDatas:
    - Name: Default
      Value: 72
    DescriptionSanitized: Well, not only that! When an emotion changes, both properties
